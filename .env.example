# Environment Variables — Monitoring Banom
# Salin file ini menjadi .env untuk development lokal
# Di Vercel: set di Settings → Environment Variables

# Wajib diisi
SESSION_SECRET=ganti-dengan-string-random-panjang-minimal-32-karakter

# Turso Database (https://turso.tech)
TURSO_DATABASE_URL=libsql://nama-db-username.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOi...

# Cloudinary (https://cloudinary.com → Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=nama-cloud-kamu
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abc123...

# Jangan diubah
NODE_ENV=production
